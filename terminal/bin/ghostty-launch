#!/bin/zsh
setopt pipefail

# Ghostty launched from Finder may not inherit the Homebrew or user bin paths.
export PATH="$HOME/.local/bin:$PATH:/opt/homebrew/bin"

launch_local() {
  local session="${1:-main}"
  if tmux has-session -t "$session" 2>/dev/null; then
    exec tmux attach-session -t "$session"
  fi
  exec tmuxinator start "$session"
}

launch_lovbox() {
  local session="${1:-main}"
  local box=morgan-dev
  local lovbox="$HOME/.local/bin/lovbox"
  local box_status
  local -a agent_options

  [[ "$session" == morgan-os ]] && agent_options=(--forward-agent)

  if [[ ! -x "$lovbox" || ! -f "$HOME/.ssh/lovbox.pub" ]]; then
    print -u2 -- 'Lovbox CLI or ~/.ssh/lovbox.pub is missing.'
    return 1
  fi

  if ! box_status="$("$lovbox" list --json | jq -r --arg name "$box" '.[] | select(.name == $name) | .status')"; then
    print -u2 -- 'Could not check the Lovbox status.'
    return 1
  fi

  case "$box_status" in
    '') "$lovbox" create "$box" --if-exists reuse --no-wait >/dev/null || return 1 ;;
    [Ss]topped) "$lovbox" start "$box" || return 1 ;;
  esac

  "$lovbox" exec --tty --key "$HOME/.ssh/lovbox.pub" "${agent_options[@]}" "$box" -- \
    bash /home/lovable/kod/dotfiles/lovbox/launch-tmux.sh "$session"
}

while true; do
  printf '\nWhere should this Ghostty terminal run?\n  1) Local (main)\n  2) Lovbox (main)\n  3) Local (Morgan OS)\n  4) Lovbox (Morgan OS)\nChoice [1]: '
  IFS= read -r choice || exit 0

  case "$choice" in
    ''|1|[Ll]) launch_local main ;;
    2|[Bb]) launch_lovbox main && exit 0 ;;
    3) launch_local morgan-os ;;
    4) launch_lovbox morgan-os && exit 0 ;;
    *) print -- 'Choose 1, 2, 3, or 4.' ;;
  esac
done
