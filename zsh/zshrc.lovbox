export DOTFILES_DIR="$HOME/kod/dotfiles"
export MONOREPO_PATH="$HOME/lovable"
export MORGAN_OS_PATH="$HOME/kod/morgan-brain"
export SHELL=/usr/bin/zsh
export EDITOR=nvim
export NVIM_DISABLE_LSP=1
export PATH="$HOME/.local/bin:$PATH"

(( ${+commands[direnv]} )) && emulate zsh -c "$(direnv export zsh)"

# Powerlevel10k instant prompt must be loaded before other Zsh initialization.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

(( ${+commands[direnv]} )) && emulate zsh -c "$(direnv hook zsh)"

source "$DOTFILES_DIR/zsh/oh-my-zsh.zsh"
[[ ! -f "$DOTFILES_DIR/zsh/p10k.zsh" ]] || source "$DOTFILES_DIR/zsh/p10k.zsh"
